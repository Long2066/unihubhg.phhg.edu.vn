rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Catch-all safety gate to deny any unspecified access
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Globally accessible variables and secure utility helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Checking if user is verified
    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.uid != null);
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == "superadmin@unihub.edu.vn";
    }

    function isThemeConfigAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "superadmin@unihub.edu.vn" ||
        request.auth.token.email == "pcthssv@hg.edu.vn"
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == role;
    }

    function isOwner(targetId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().targetId == targetId;
    }

    // 3. Entity Validator Utilities
    function isValidUser(data) {
      return data.keys().hasOnly(['id', 'username', 'name', 'role', 'email', 'targetId', 'password', 'isGroupLeader', 'groupInCharge', 'monitorTitle'])
        && data.id is string && data.id.size() <= 128
        && data.username is string && data.username.size() <= 128
        && data.name is string && data.name.size() <= 128
        && data.role is string && data.role.size() <= 32
        && data.email is string && data.email.size() <= 128
        && (!data.keys().contains('isGroupLeader') || data.isGroupLeader is bool)
        && (!data.keys().contains('groupInCharge') || (data.groupInCharge is string && data.groupInCharge.size() <= 128))
        && (!data.keys().contains('monitorTitle') || (data.monitorTitle is string && data.monitorTitle.size() <= 128));
    }

    function isValidStudent(data) {
      return data.keys().hasOnly(['id', 'name', 'classId', 'facultyId', 'email', 'avatar', 'gpa', 'creditsEarned', 'learningWarning', 'learningStatus', 'learningDataLocked', 'gender', 'dob', 'pob', 'ethnicity', 'idCard', 'idCardDate', 'idCardPlace', 'subjects', 'subjectGrades', 'gpa10', 'academicGrade', 'notes', 'updatedAt', 'religion', 'nationality', 'bhyt', 'priorityObject', 'priorityArea', 'phone', 'permanentAddress', 'permanentProvince', 'permanentWard', 'temporaryAddress', 'fatherName', 'fatherJob', 'fatherPhone', 'motherName', 'motherJob', 'motherPhone', 'trainingSystem', 'trainingCourse', 'trainingMajor', 'specialization', 'facultyInCharge', 'academicYears', 'adviser', 'registeredSubjectsCount', 'creditClassesList', 'enrollmentNotes', 'accumulatedCredits', 'totalTuition', 'paidTuition', 'debtTuition', 'paymentStatus', 'groupName'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.facultyId is string && data.facultyId.size() <= 64
        && data.email is string && data.email.size() <= 128
        && (!data.keys().contains('groupName') || (data.groupName is string && data.groupName.size() <= 128));
    }

    function isValidOrganization(data) {
      return data.keys().hasOnly(['id', 'name', 'type', 'leaderName', 'field', 'level'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 256
        && data.type is string && (data.type == 'CLB' || data.type == 'DOAN' || data.type == 'HOI')
        && data.leaderName is string && data.leaderName.size() <= 128
        && data.field is string && data.field.size() <= 256
        && data.level is string && (data.level == 'TRUONG' || data.level == 'KHOA');
    }

    function isValidMember(data) {
      return data.keys().hasOnly(['id', 'studentId', 'classId', 'orgId', 'role', 'joinedDate', 'term', 'status', 'gender', 'dob', 'ethnicity', 'email', 'phone', 'permanentAddress', 'temporaryAddress', 'major', 'facultyInCharge', 'studentName', 'attachmentUrl'])
        && data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.orgId is string && data.orgId.size() <= 64
        && data.role is string && data.role.size() <= 64
        && data.joinedDate is string && data.joinedDate.size() <= 64
        && data.status is string && data.status.size() <= 64;
    }

    function isValidClubAnnouncement(data) {
      return data.keys().hasOnly(['id', 'orgId', 'orgName', 'title', 'content', 'createdAt', 'expiryDate', 'activityId', 'imageUrl'])
        && data.id is string && data.id.size() <= 128
        && data.orgId is string && data.orgId.size() <= 64
        && data.orgName is string && data.orgName.size() <= 256
        && data.title is string && data.title.size() <= 256
        && data.content is string && data.content.size() <= 5000
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Checking validation for activities
    function isValidActivity(data) {
      return data.keys().hasOnly(['id', 'title', 'orgId', 'orgName', 'criteriaId', 'points', 'dateTime', 'location', 'description', 'registrationOpen', 'status', 'imageUrl', 'expiryDate', 'maxParticipants'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.orgId is string && data.orgId.size() <= 64
        && data.orgName is string && data.orgName.size() <= 256
        && data.criteriaId is string && data.criteriaId.size() <= 64
        && data.points is number && data.points <= 100
        && data.dateTime is string && data.dateTime.size() <= 64
        && data.location is string && data.location.size() <= 256
        && data.status is string && (data.status == 'UPCOMING' || data.status == 'ONGOING' || data.status == 'COMPLETED')
        && (!data.keys().contains('maxParticipants') || data.maxParticipants is number);
    }

    function isValidActivityAttendance(data) {
      return data.keys().hasOnly(['id', 'activityId', 'studentId', 'studentName', 'classId', 'registeredAt', 'role', 'attended', 'verified'])
        && data.id is string && data.id.size() <= 128
        && data.activityId is string && data.activityId.size() <= 128
        && data.studentId is string && data.studentId.size() <= 64
        && data.studentName is string && data.studentName.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.role is string && (data.role == 'MEM' || data.role == 'BTC' || data.role == 'SUPPORTER')
        && data.attended is bool
        && data.verified is bool;
    }

    function isValidEvidenceSubmission(data) {
      return data.keys().hasOnly(['id', 'studentId', 'studentName', 'classId', 'criteriaId', 'activityName', 'description', 'pointsRequested', 'proofUrl', 'submittedAt', 'status', 'reviewedBy', 'reviewComment'])
        && data.id is string && data.id.size() <= 128
        && data.studentId is string && data.studentId.size() <= 64
        && data.studentName is string && data.studentName.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.criteriaId is string && data.criteriaId.size() <= 64
        && data.activityName is string && data.activityName.size() <= 256
        && data.pointsRequested is number && data.pointsRequested <= 100
        && data.proofUrl is string && data.proofUrl.size() <= 1024
        && data.submittedAt is string && data.submittedAt.size() <= 64
        && data.status is string && (data.status == 'PENDING' || data.status == 'APPROVED' || data.status == 'REJECTED');
    }

    function isValidEvaluationResult(data) {
      return data.keys().hasOnly(['studentId', 'studentName', 'classId', 'facultyId', 'periodId', 'studyPoints', 'violationPoints', 'extracurricularPoints', 'communityPoints', 'achievementPoints', 'totalPoints', 'grade', 'status', 'adviserNotes', 'logs'])
        && data.studentId is string && data.studentId.size() <= 64
        && data.studentName is string && data.studentName.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.facultyId is string && data.facultyId.size() <= 64
        && data.periodId is string && data.periodId.size() <= 64
        && data.studyPoints is number
        && data.violationPoints is number
        && data.extracurricularPoints is number
        && data.communityPoints is number
        && data.achievementPoints is number
        && data.totalPoints is number
        && data.grade is string && (data.grade == 'XUẤT SẮC' || data.grade == 'TỐT' || data.grade == 'KHÁ' || data.grade == 'TRUNG BÌNH' || data.grade == 'YẾU' || data.grade == 'KÉM')
        && data.status is string && (data.status == 'AUTO' || data.status == 'PENDING_CLASS' || data.status == 'APPROVED_CLASS' || data.status == 'APPROVED_ADVISER' || data.status == 'LOCKED');
    }

    function isValidDailyAttendanceReport(data) {
      return data.keys().hasOnly(['id', 'classId', 'date', 'totalStudents', 'presentCount', 'absentCount', 'absentees', 'reportedBy', 'reportedAt'])
        && data.id is string && data.id.size() <= 128
        && data.classId is string && data.classId.size() <= 64
        && data.date is string && data.date.size() <= 64
        && data.totalStudents is number
        && data.presentCount is number
        && data.absentCount is number
        && data.reportedBy is string && data.reportedBy.size() <= 128
        && data.reportedAt is string && data.reportedAt.size() <= 64;
    }

    function isValidPointCriteria(data) {
      return data.keys().hasOnly(['id', 'category', 'maxScore', 'description', 'rules'])
        && data.id is string && data.id.size() <= 64
        && data.category is string && data.category.size() <= 128
        && data.maxScore is number
        && data.description is string && data.description.size() <= 512
        && data.rules is list;
    }

    function isValidClassReview(data) {
      return data.keys().hasOnly([
        'classId', 'representativeApproved', 'adviserApproved', 'facultyApproved', 'adminApproved',
        'adviserComment', 'facultyComment', 'adminComment',
        'representativeApprovedAt', 'adviserApprovedAt', 'facultyApprovedAt', 'adminApprovedAt'
      ])
        && data.classId is string && data.classId.size() <= 64
        && data.representativeApproved is bool
        && data.adviserApproved is bool
        && (!data.keys().contains('facultyApproved') || data.facultyApproved is bool)
        && (!data.keys().contains('adminApproved') || data.adminApproved is bool)
        && (!data.keys().contains('adviserComment') || (data.adviserComment is string && data.adviserComment.size() <= 500))
        && (!data.keys().contains('facultyComment') || (data.facultyComment is string && data.facultyComment.size() <= 500))
        && (!data.keys().contains('adminComment') || (data.adminComment is string && data.adminComment.size() <= 500))
        && (!data.keys().contains('representativeApprovedAt') || (data.representativeApprovedAt is string && data.representativeApprovedAt.size() <= 64))
        && (!data.keys().contains('adviserApprovedAt') || (data.adviserApprovedAt is string && data.adviserApprovedAt.size() <= 64))
        && (!data.keys().contains('facultyApprovedAt') || (data.facultyApprovedAt is string && data.facultyApprovedAt.size() <= 64))
        && (!data.keys().contains('adminApprovedAt') || (data.adminApprovedAt is string && data.adminApprovedAt.size() <= 64));
    }

    function isValidFacultyReview(data) {
      return data.keys().hasOnly(['facultyId', 'locked', 'lockedAt', 'lockedBy'])
        && data.facultyId is string && data.facultyId.size() <= 64
        && data.locked is bool
        && (!data.keys().contains('lockedAt') || (data.lockedAt is string && data.lockedAt.size() <= 64))
        && (!data.keys().contains('lockedBy') || (data.lockedBy is string && data.lockedBy.size() <= 128));
    }

    // 4. Secure Collections Match rules
    match /users/{userId} {
      allow get: if isVerifiedUser() && (
        userId == request.auth.uid || 
        hasRole('ADMIN') ||
        isSuperAdmin() ||
        hasRole('TRAINING_DEPT') ||
        hasRole('FACULTY') ||
        (hasRole('ADVISER') && getUserData().targetId == existing().targetId) ||
        (hasRole('CLASS_MONITOR') && getUserData().targetId == existing().targetId)
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') ||
        isSuperAdmin() ||
        hasRole('TRAINING_DEPT') ||
        hasRole('FACULTY') ||
        hasRole('ADVISER') ||
        hasRole('CLASS_MONITOR')
      );
      allow create: if isVerifiedUser() && (
        isSuperAdmin() ||
        hasRole('ADMIN') ||
        (userId == request.auth.uid && incoming().role == 'STUDENT') ||
        (hasRole('CLASS_MONITOR') && incoming().role == 'CLASS_MONITOR' && incoming().isGroupLeader == true)
      );
      allow update: if isVerifiedUser() && (
        isSuperAdmin() ||
        hasRole('ADMIN') || (
          userId == request.auth.uid && 
          incoming().role == existing().role && 
          incoming().targetId == existing().targetId &&
          incoming().id == existing().id
        )
      );
      allow delete: if isSuperAdmin() || hasRole('ADMIN') || (hasRole('CLASS_MONITOR') && existing().role == 'CLASS_MONITOR' && existing().isGroupLeader == true);
    }

    match /students/{studentId} {
      allow get: if isVerifiedUser() && (
        studentId == request.auth.uid || 
        hasRole('ADMIN') || 
        hasRole('TRAINING_DEPT') || 
        hasRole('FACULTY') ||
        (hasRole('ADVISER') && getUserData().targetId == existing().classId) ||
        (hasRole('CLASS_MONITOR') && getUserData().targetId == existing().classId) ||
        hasRole('ORGANIZER')
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') || 
        hasRole('TRAINING_DEPT') || 
        hasRole('FACULTY') ||
        hasRole('ADVISER') || 
        hasRole('CLASS_MONITOR') || 
        hasRole('ORGANIZER')
      );
      allow create, delete: if isVerifiedUser() && isValidId(studentId) && (hasRole('ADMIN') || hasRole('TRAINING_DEPT'));
      allow update: if isVerifiedUser() && isValidId(studentId) && (
        hasRole('ADMIN') || 
        hasRole('TRAINING_DEPT') || 
        (
          studentId == request.auth.uid && 
          incoming().classId == existing().classId && 
          incoming().facultyId == existing().facultyId && 
          incoming().id == existing().id &&
          incoming().gpa == existing().gpa && 
          incoming().creditsEarned == existing().creditsEarned && 
          incoming().learningWarning == existing().learningWarning && 
          incoming().learningStatus == existing().learningStatus && 
          incoming().learningDataLocked == existing().learningDataLocked
        )
      ) && isValidStudent(incoming());
    }

    match /organizations/{orgId} {
      allow get, list: if isVerifiedUser();
      allow create, delete: if isVerifiedUser() && isValidId(orgId) && hasRole('ADMIN');
      allow update: if isVerifiedUser() && isValidId(orgId) && (
        hasRole('ADMIN') || (hasRole('ORGANIZER') && isOwner(orgId))
      ) && isValidOrganization(incoming());
    }

    match /members/{memberId} {
      allow get: if isVerifiedUser() && (
        existing().studentId == getUserData().targetId ||
        hasRole('ADMIN') ||
        (hasRole('ORGANIZER') && existing().orgId == getUserData().targetId)
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') ||
        hasRole('ORGANIZER') ||
        (hasRole('STUDENT') && resource.data.studentId == getUserData().targetId)
      );
      allow create: if isVerifiedUser() && isValidId(memberId) && (
        hasRole('ADMIN') || 
        (hasRole('STUDENT') && incoming().studentId == getUserData().targetId && incoming().status == 'PENDING' && incoming().role == 'THÀNH VIÊN') ||
        (hasRole('ORGANIZER') && incoming().orgId == getUserData().targetId)
      ) && isValidMember(incoming());
      allow update: if isVerifiedUser() && isValidId(memberId) && (
        hasRole('ADMIN') || 
        (hasRole('ORGANIZER') && existing().orgId == getUserData().targetId && incoming().orgId == existing().orgId)
      ) && isValidMember(incoming());
      allow delete: if isVerifiedUser() && isValidId(memberId) && (
        hasRole('ADMIN') || 
        (hasRole('ORGANIZER') && existing().orgId == getUserData().targetId) ||
        (hasRole('STUDENT') && existing().studentId == getUserData().targetId)
      );
    }

    match /announcements/{announcementId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(announcementId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && incoming().orgId == getUserData().targetId)) && isValidClubAnnouncement(incoming());
      allow update: if isVerifiedUser() && isValidId(announcementId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && incoming().orgId == getUserData().targetId && existing().orgId == getUserData().targetId && incoming().createdAt == existing().createdAt)) && isValidClubAnnouncement(incoming());
      allow delete: if isVerifiedUser() && isValidId(announcementId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && existing().orgId == getUserData().targetId));
    }

    match /activities/{activityId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(activityId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && incoming().orgId == getUserData().targetId)) && isValidActivity(incoming());
      allow update: if isVerifiedUser() && isValidId(activityId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && incoming().orgId == getUserData().targetId && existing().orgId == getUserData().targetId)) && isValidActivity(incoming());
      allow delete: if isVerifiedUser() && isValidId(activityId) && (hasRole('ADMIN') || (hasRole('ORGANIZER') && existing().orgId == getUserData().targetId));
    }

    match /attendance/{attendanceId} {
      allow get, list: if isVerifiedUser();
      allow create: if isVerifiedUser() && isValidId(attendanceId) && (
        hasRole('ADMIN') || 
        (hasRole('STUDENT') && incoming().studentId == getUserData().targetId && incoming().attended == false && incoming().verified == false && incoming().role == 'MEM') ||
        (hasRole('ORGANIZER') && get(/databases/$(database)/documents/activities/$(incoming().activityId)).data.orgId == getUserData().targetId)
      ) && isValidActivityAttendance(incoming());
      allow update: if isVerifiedUser() && isValidId(attendanceId) && (
        hasRole('ADMIN') || 
        (hasRole('ORGANIZER') && get(/databases/$(database)/documents/activities/$(existing().activityId)).data.orgId == getUserData().targetId)
      ) && isValidActivityAttendance(incoming());
      allow delete: if isVerifiedUser() && isValidId(attendanceId) && (
        hasRole('ADMIN') || 
        (hasRole('ORGANIZER') && get(/databases/$(database)/documents/activities/$(existing().activityId)).data.orgId == getUserData().targetId) ||
        (hasRole('STUDENT') && existing().studentId == getUserData().targetId && existing().verified == false)
      );
    }

    match /evidence/{evidenceId} {
      allow get: if isVerifiedUser() && (
        existing().studentId == getUserData().targetId ||
        hasRole('ADMIN') ||
        ((hasRole('ADVISER') || hasRole('CLASS_MONITOR')) && getUserData().targetId == existing().classId) ||
        hasRole('FACULTY')
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') ||
        hasRole('FACULTY') ||
        hasRole('ADVISER') ||
        hasRole('CLASS_MONITOR') ||
        (hasRole('STUDENT') && resource.data.studentId == getUserData().targetId)
      );
      allow create: if isVerifiedUser() && isValidId(evidenceId) && (
        hasRole('ADMIN') || 
        (hasRole('STUDENT') && incoming().studentId == getUserData().targetId && incoming().status == 'PENDING')
      ) && isValidEvidenceSubmission(incoming());
      allow update: if isVerifiedUser() && isValidId(evidenceId) && (
        hasRole('ADMIN') || 
        ((hasRole('ADVISER') || hasRole('CLASS_MONITOR')) && getUserData().targetId == existing().classId && incoming().submittedAt == existing().submittedAt) ||
        (hasRole('STUDENT') && existing().studentId == getUserData().targetId && existing().status == 'PENDING' && incoming().status == 'PENDING' && incoming().studentId == existing().studentId && incoming().submittedAt == existing().submittedAt)
      ) && isValidEvidenceSubmission(incoming());
      allow delete: if isVerifiedUser() && isValidId(evidenceId) && (
        hasRole('ADMIN') || 
        (existing().studentId == getUserData().targetId && existing().status == 'PENDING')
      );
    }

    match /results/{resultId} {
      allow get: if isVerifiedUser() && (
        existing().studentId == getUserData().targetId ||
        hasRole('ADMIN') ||
        hasRole('TRAINING_DEPT') ||
        ((hasRole('ADVISER') || hasRole('CLASS_MONITOR')) && getUserData().targetId == existing().classId) ||
        (hasRole('FACULTY') && getUserData().targetId == existing().facultyId)
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') ||
        hasRole('TRAINING_DEPT') ||
        hasRole('FACULTY') ||
        hasRole('ADVISER') ||
        hasRole('CLASS_MONITOR') ||
        (hasRole('STUDENT') && resource.data.studentId == getUserData().targetId)
      );
      allow create, update: if isVerifiedUser() && isValidId(resultId) && (
        hasRole('ADMIN') || (
          (existing() == null || (existing().status != 'LOCKED' && incoming().classId == existing().classId && incoming().facultyId == existing().facultyId)) && (
            (hasRole('ADVISER') && getUserData().targetId == incoming().classId) ||
            (hasRole('CLASS_MONITOR') && getUserData().targetId == incoming().classId) ||
            (hasRole('FACULTY') && getUserData().targetId == incoming().facultyId) ||
            (hasRole('STUDENT') && incoming().studentId == getUserData().targetId && incoming().status == 'AUTO' && (existing() == null || incoming().adviserNotes == existing().adviserNotes))
          )
        )
      ) && isValidEvaluationResult(incoming());
      allow delete: if isVerifiedUser() && isValidId(resultId) && hasRole('ADMIN');
    }

    match /dailyAttendance/{attendanceId} {
      allow get: if isVerifiedUser() && (
        hasRole('ADMIN') || 
        getUserData().targetId == existing().classId ||
        hasRole('TRAINING_DEPT') ||
        hasRole('FACULTY')
      );
      allow list: if isVerifiedUser() && (
        hasRole('ADMIN') || 
        hasRole('TRAINING_DEPT') ||
        hasRole('FACULTY') ||
        hasRole('ADVISER') ||
        hasRole('CLASS_MONITOR')
      );
      allow create, update: if isVerifiedUser() && isValidId(attendanceId) && (
        hasRole('ADMIN') || 
        (hasRole('CLASS_MONITOR') && getUserData().targetId == incoming().classId) ||
        (hasRole('ADVISER') && getUserData().targetId == incoming().classId)
      ) && isValidDailyAttendanceReport(incoming());
      allow delete: if isVerifiedUser() && isValidId(attendanceId) && (
        hasRole('ADMIN') || 
        (hasRole('CLASS_MONITOR') && getUserData().targetId == existing().classId) ||
        (hasRole('ADVISER') && getUserData().targetId == existing().classId)
      );
    }

    match /criteria/{criteriaId} {
      allow read: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(criteriaId) && (hasRole('ADMIN') || isSuperAdmin()) && isValidPointCriteria(incoming());
      allow delete: if isVerifiedUser() && isValidId(criteriaId) && (hasRole('ADMIN') || isSuperAdmin());
    }

    match /classReviews/{classId} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(classId) && (
        hasRole('ADMIN') ||
        isSuperAdmin() ||
        (hasRole('CLASS_MONITOR') && getUserData().targetId == classId) ||
        (hasRole('ADVISER') && getUserData().targetId == classId) ||
        hasRole('FACULTY') ||
        hasRole('TRAINING_DEPT')
      ) && isValidClassReview(incoming());
      allow delete: if isVerifiedUser() && isValidId(classId) && (hasRole('ADMIN') || isSuperAdmin());
    }

    match /facultyReviews/{facultyId} {
      allow get, list: if isVerifiedUser();
      allow create, update: if isVerifiedUser() && isValidId(facultyId) && (
        hasRole('ADMIN') ||
        isSuperAdmin() ||
        (hasRole('FACULTY') && getUserData().targetId == facultyId) ||
        hasRole('TRAINING_DEPT')
      ) && isValidFacultyReview(incoming());
      allow delete: if isVerifiedUser() && isValidId(facultyId) && (hasRole('ADMIN') || isSuperAdmin());
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isVerifiedUser() && (
        hasRole('ADMIN') ||
        isSuperAdmin() ||
        (configId == 'theme' && isThemeConfigAdmin())
      );
    }

  }
}
