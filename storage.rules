rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isThemeAdmin() {
      return request.auth != null && (
        request.auth.token.email == "superadmin@unihub.edu.vn" ||
        request.auth.token.email == "pcthssv@hg.edu.vn"
      );
    }

    match /theme/{allPaths=**} {
      allow read: if true;
      allow create, update: if isThemeAdmin()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isThemeAdmin();
    }
  }
}
